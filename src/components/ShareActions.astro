---
type ShareAction =
  | "x"
  | "linkedin"
  | "facebook"
  | "whatsapp"
  | "mastodon"
  | "bluesky"
  | "email"
  | "print";

interface Props {
  url: string;
  title: string;
  description?: string;
  actions?: ShareAction[];
}

const {
  url,
  title,
  description = title,
  actions = [
    "x",
    "linkedin",
    "facebook",
    "whatsapp",
    "mastodon",
    "bluesky",
    "email",
    "print",
  ],
} = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const sharedText = encodeURIComponent(`${title} ${url}`);
const emailBody = encodeURIComponent(`${description}\n\n${url}`);

const actionUrls: Partial<Record<ShareAction, string>> = {
  x: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  whatsapp: `https://api.whatsapp.com/send?text=${sharedText}`,
  mastodon: `https://toot.kytta.dev/?text=${sharedText}`,
  bluesky: `https://bsky.app/intent/compose?text=${sharedText}`,
  email: `mailto:?subject=${encodedTitle}&body=${emailBody}`,
};

const actionLabels: Record<ShareAction, string> = {
  x: "Compartir en X (Twitter)",
  linkedin: "Compartir en LinkedIn",
  facebook: "Compartir en Facebook",
  whatsapp: "Compartir en WhatsApp",
  mastodon: "Compartir en Mastodon",
  bluesky: "Compartir en Bluesky",
  email: "Enviar por correo",
  print: "Guardar en PDF",
};

const actionHoverClasses: Record<ShareAction, string> = {
  x: "hover:bg-black",
  linkedin: "hover:bg-[#0077b5]",
  facebook: "hover:bg-[#1877f2]",
  whatsapp: "hover:bg-[#25D366]",
  mastodon: "hover:bg-[#6364FF]",
  bluesky: "hover:bg-[#0085ff]",
  email: "hover:bg-slate-700",
  print: "hover:bg-slate-700",
};

const buttonBaseClass =
  "inline-flex items-center justify-center p-2.5 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-600 dark:text-slate-300 hover:text-white transition-all hover:-translate-y-1";
---

<div
  class="mt-12 flex flex-wrap items-center justify-center gap-4 animate-fade-in-up"
>
  <span
    class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider"
  >
    Compartir:
  </span>
  <div class="flex flex-wrap justify-center gap-3">
    {
      actions.map((action) => {
        const buttonClass = `${buttonBaseClass} ${actionHoverClasses[action]}`;

        if (action === "print") {
          return (
            <button
              type="button"
              class={buttonClass}
              aria-label={actionLabels[action]}
              title={actionLabels[action]}
              data-share-print
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M19 8h-1V3H6v5H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zM8 5h8v3H8V5zm8 12v2H8v-2h8zm2-2v-2H6v2H4v-4c0-.55.45-1 1-1h14c.55 0 1 .45 1 1v4h-2z" />
                <circle cx="18" cy="11.5" r="1" />
              </svg>
            </button>
          );
        }

        const href = actionUrls[action];
        if (!href) return null;

        return (
          <a
            href={href}
            target={action === "email" ? undefined : "_blank"}
            rel={action === "email" ? undefined : "noopener noreferrer"}
            class={buttonClass}
            aria-label={actionLabels[action]}
            title={actionLabels[action]}
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              {action === "x" && (
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              )}
              {action === "linkedin" && (
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                />
              )}
              {action === "facebook" && (
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                />
              )}
              {action === "whatsapp" && (
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12.31 1.75c-5.52 0-10 4.48-10 10 0 1.76.46 3.42 1.27 4.88L2.5 21.75l5.24-1.09c1.4.77 3 1.18 4.67 1.18 5.52 0 10-4.48 10-10s-4.48-10-10-10zm0 18.25c-1.5 0-2.95-.39-4.22-1.07l-.3-.16-3.13.65.83-3.05-.19-.31c-.79-1.27-1.21-2.76-1.21-4.29 0-4.55 3.7-8.25 8.25-8.25s8.25 3.7 8.25 8.25-3.7 8.25-8.25 8.25zm4.52-6.18c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.12-.17.25-.65.81-.8.97-.15.16-.3.19-.55.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28z"
                />
              )}
              {action === "mastodon" && (
                <path d="M19.333 3.25c-3.15-.2-6.283-.2-9.433 0-3.834.25-5.917.433-6.55 3.366-.234 1.084-.45 4.3-.45 6.434 0 3.733.266 7.216 4.3 8.3 2.116.566 4.266.666 6.383.316 2.067-.35 3.75-1.3 4.267-3.333h-2.3c-.233 1.133-1.6 1.666-3.233 1.666-1.817 0-3.367-.283-3.55-2.283v-.35c1.483.45 3.366.583 4.9.466 2.467-.183 4.533-1.333 5.084-3.5.583-2.3.45-5.767.45-6.433 0-3.667-2.917-4.45-5.967-4.65zM12.017 12.35c-1.633 0-2.85-1.117-2.85-2.9 0-1.784 1.217-2.9 2.85-2.9 1.633 0 2.85 1.116 2.85 2.9 0 1.783-1.217 2.9-2.85 2.9z" />
              )}
              {action === "bluesky" && (
                <path d="M12 10.8c-1.6-4.2-7.3-6.9-10.7-7.2 2.7 1.2 5.8 4.3 6.4 8.7-4.4-1.1-9.2-1.3-10.8.6-.2.2-.1.6.1.7 2.2 1.7 9 2.7 9 2.7s-6.8 1-9 2.7c-.2.2-.3.5-.1.7 1.6 1.9 6.4 1.7 10.8.6-.6 4.4-3.7 7.5-6.4 8.7 3.4-.3 9.1-3 10.7-7.2 1.6 4.2 7.3 6.9 10.7 7.2-2.7-1.2-5.8-4.3-6.4-8.7 4.4 1.1 9.2 1.3 10.8-.6.2-.2.1-.6-.1-.7-2.2-1.7-9-2.7-9-2.7s6.8-1 9-2.7c.2-.2.3-.5.1-.7-1.6-1.9-6.4-1.7-10.8-.6.6-4.4 3.7-7.5 6.4-8.7-3.4.3-9.1 3-10.7 7.2z" />
              )}
              {action === "email" && (
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
              )}
            </svg>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  document.addEventListener("click", (event) => {
    const printButton = (event.target as Element).closest<HTMLButtonElement>(
      "[data-share-print]",
    );
    if (!printButton) return;

    document
      .querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
      .forEach((image) => {
        image.loading = "eager";
        image.src = image.src;
      });
    window.setTimeout(() => window.print(), 500);
  });
</script>
