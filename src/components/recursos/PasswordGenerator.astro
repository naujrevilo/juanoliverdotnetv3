---
/**
 * @fileoverview Generador de contraseñas deterministas.
 * Combina letras base + indicio de servicio + clave personal en una
 * contraseña larga, donde el "segmento raíz" se deriva con cascada
 * criptográfica Web Crypto:
 *
 *   1) SHA-256 sobre (clave personal + servicio + dominio "pg-ikm-v1")
 *      como material inicial (IKM).
 *   2) HKDF-SHA256 Extract+Expand con info "pg-prefix-v1" para obtener
 *      una subclave de 256 bits separada del tag y de futuros usos.
 *   3) HMAC-SHA256 sobre la subclave como PRF por posición: para cada
 *      letra base escoge deterministamente un candidato del pool
 *      limitado por los toggles Mayúsculas/Números/Símbolos/Español.
 *
 * Sin la clave personal, ningún observador puede reconstruir la raíz
 * aunque conozca las letras base y el leetspeak típico. La posición
 * del segmento raíz dentro de la contraseña se aleatoriza en cada
 * generación con `crypto.getRandomValues`, y el resto se completa con
 * aleatoriedad criptográfica real. 100% en el navegador: nada se
 * envía ni se guarda.
 *
 * Estilos: usa los tokens de Tailwind del proyecto (slate-*,
 * security-yellow, font-mono, etc.) y deja el <style> scoped
 * únicamente para lo que no se puede expresar con utilidades
 * (animaciones, nth-child del dial decorativo, variantes de estado
 * de toggles/ghost-btn/generate-btn y el indicador `.pg-constrained`
 * del campo de letras base cuando Español está apagado).
 *
 * @module components/recursos/PasswordGenerator
 */
---

<div data-password-gen class="w-full max-w-2xl mx-auto">
  <!--
    Honeypot: inputs invisibles al usuario pero presentes en el DOM.
    El navegador / gestor de contraseñas los detecta como los campos
    "reales" y vuelca ahí el autofill, dejando en paz los inputs de
    la herramienta. Se posicionan fuera de pantalla (no display:none,
    porque algunos managers ignoran nodos con display:none).
  -->
  <div
    aria-hidden="true"
    data-pg-honeypot
    style="position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; opacity:0; pointer-events:none;"
  >
    <label>
      Email
      <input type="email" name="email" tabindex="-1" autocomplete="email" />
    </label>
    <label>
      Password actual
      <input type="password" name="current-password" tabindex="-1" autocomplete="current-password" />
    </label>
  </div>

  <!-- Dial decorativo (estético, sin texto) -->
  <div class="dial-row" aria-hidden="true">
    {Array.from({ length: 24 }).map(() => <span></span>)}
  </div>

  <!-- Cabecera interna de la herramienta -->
  <header class="text-center mb-9 max-w-md mx-auto">
    <p class="text-xs font-mono uppercase tracking-widest text-security-yellow mb-2.5">
      Una contraseña nueva en cada clic &middot; nada se guarda
    </p>
    <h1 class="font-mono text-3xl font-semibold tracking-tight text-security-blue mb-2.5">
      Protege
    </h1>
    <p class="text-sm text-slate-400 leading-relaxed">
      Convierte unas letras que ya recuerdas en una contraseña larga y
      distinta para cada servicio. Todo el cálculo ocurre en tu navegador:
      no se envía ni se almacena nada.
    </p>
  </header>

  <!-- Tarjeta principal (panel oscuro auto-contenido) -->
  <div class="bg-slate-900 border border-slate-700 rounded-2xl overflow-hidden shadow-2xl">

    <!-- Paso 01 — Letras base -->
    <section class="p-6 border-b border-slate-800">
      <h2 class="step-label">
        <span class="text-security-yellow">01</span>
        <span>Letras base</span>
        <span class="flex-1 h-px bg-slate-800"></span>
      </h2>
      <label for="baseLetters" class="field-label">
        Una palabra o letras que ya memorizaste
      </label>
      <input
        type="text"
        id="baseLetters"
        name="base-letters"
        placeholder="p. ej. RPSOTETRA"
        maxlength="24"
        autocomplete="off"
        spellcheck="false"
        data-1p-ignore
        data-bwignore
        data-lpignore
        data-form-type="other"
        class="field-input"
        aria-describedby="baseLettersHint"
      />
      <p
        id="baseLettersHint"
        class="hidden mt-1.5 font-mono text-[11px] leading-snug text-security-yellow"
        aria-live="polite"
      ></p>
    </section>

    <!-- Paso 02 — Clave personal -->
    <section class="p-6 border-b border-slate-800">
      <h2 class="step-label">
        <span class="text-security-yellow">02</span>
        <span>Clave personal</span>
        <span class="flex-1 h-px bg-slate-800"></span>
      </h2>
      <label for="secret" class="field-label">
        Tu clave secreta (no se guarda ni se envía a ningún lado)
      </label>
      <input
        type="password"
        id="secret"
        name="personal-secret"
        placeholder="algo que solo tú sabes"
        autocomplete="new-password"
        data-1p-ignore
        data-bwignore
        data-lpignore
        data-form-type="other"
        class="field-input"
      />
    </section>

    <!-- Paso 03 — Servicio -->
    <section class="p-6 border-b border-slate-800">
      <h2 class="step-label">
        <span class="text-security-yellow">03</span>
        <span>Servicio</span>
        <span class="flex-1 h-px bg-slate-800"></span>
      </h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label for="serviceSelect" class="field-label">Servicio</label>
          <select id="serviceSelect" class="field-input">
            <option value="">-- elegir --</option>
            <option value="Gmail">Gmail</option>
            <option value="Outlook">Outlook</option>
            <option value="Netflix">Netflix</option>
            <option value="Amazon">Amazon</option>
            <option value="GitHub">GitHub</option>
            <option value="Instagram">Instagram</option>
            <option value="Banco">Banco</option>
            <option value="__custom">Otro (escribir)</option>
          </select>
        </div>
        <div>
          <label for="serviceCustom" class="field-label">Nombre / indicio</label>
          <input
            type="text"
            id="serviceCustom"
            name="service-custom"
            placeholder="ej. spotify"
            maxlength="20"
            autocomplete="off"
            data-1p-ignore
            data-bwignore
            data-lpignore
            data-form-type="other"
            class="field-input"
          />
        </div>
      </div>
    </section>

    <!-- Paso 04 — Formato -->
    <section class="p-6 border-b border-slate-800">
      <h2 class="step-label">
        <span class="text-security-yellow">04</span>
        <span>Formato</span>
        <span class="flex-1 h-px bg-slate-800"></span>
      </h2>
      <label for="lengthRange" class="field-label">Longitud total</label>
      <div class="flex items-center gap-3.5 mt-3.5">
        <input
          type="range"
          id="lengthRange"
          min="12"
          max="32"
          value="22"
          class="flex-1 accent-security-yellow"
        />
        <span id="lengthVal" class="font-mono text-sm text-security-yellow min-w-14 text-right">22</span>
      </div>
      <div class="flex flex-wrap gap-2 mt-3">
        <div class="toggle on" data-opt="upper">Mayúsculas</div>
        <div class="toggle on" data-opt="digits">Números</div>
        <div class="toggle on" data-opt="symbols">Símbolos</div>
        <div class="toggle on" data-opt="spanish" title="Incluye la ñ y las vocales con tilde en el alfabeto (default ON).">Español</div>
      </div>
    </section>

    <!-- Paso 05 — Resultado -->
    <section class="p-6 bg-slate-950">
      <h2 class="step-label">
        <span class="text-security-yellow">05</span>
        <span>Resultado</span>
        <span class="flex-1 h-px bg-slate-800"></span>
      </h2>
      <div id="reel" class="font-mono text-lg bg-slate-900 border border-slate-700 rounded-lg p-4 break-all min-h-14 flex flex-wrap items-center gap-px text-slate-100">
        <span class="empty-hint">Completa los campos y pulsa generar.</span>
      </div>
      <div class="flex gap-2.5 mt-3">
        <button id="copyBtn" type="button" class="ghost-btn">Copiar</button>
        <button id="revealAgainBtn" type="button" class="ghost-btn">Regenerar vista</button>
      </div>
      <div id="strength" class="hidden items-center gap-2 mt-3.5 font-mono text-xs text-slate-500">
        <span>fuerza</span>
        <div class="flex gap-0.5">
          <i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i>
        </div>
        <span id="strengthLabel"></span>
      </div>
      <div id="breakdown" class="hidden mt-4 pt-3.5 border-t border-dashed border-slate-800 font-mono text-xs text-slate-500 leading-relaxed"></div>
    </section>

    <!-- Botón generar -->
    <div class="p-6 border-t border-slate-800">
      <button id="generateBtn" type="button" class="generate-btn">
        Generar contraseña
      </button>
    </div>
  </div>

  <!-- Buenas prácticas -->
  <aside class="mt-5 bg-slate-900 border border-slate-700 rounded-2xl p-5">
    <h2 class="text-xs font-mono uppercase tracking-widest text-security-yellow mb-3">Buenas prácticas</h2>
    <ul class="text-slate-400 text-sm space-y-1.5 list-disc list-inside marker:text-security-yellow">
      <li>Activa la verificación en dos pasos (2FA) en cada servicio que la ofrezca; una contraseña fuerte no reemplaza al 2FA.</li>
      <li>Usa una clave personal distinta a las que ya usaste en otros lados, y que no aparezca en ningún filtrado conocido.</li>
      <li>Guarda las contraseñas que generes en un gestor de contraseñas cifrado — no en notas planas, hojas de cálculo o el navegador sin cifrar.</li>
      <li>No reutilices la misma contraseña generada aquí en más de un servicio, aunque cambies apenas el indicio.</li>
      <li>Para cuentas críticas (correo principal, banco, el propio gestor de contraseñas) usa además una contraseña totalmente aleatoria de un gestor, no un esquema memorizable como este.</li>
      <li>No escribas tu clave personal ni tus letras base en post-its, notas del teléfono o archivos sin cifrar cerca del dispositivo.</li>
      <li>Cambia la contraseña de un servicio de inmediato si ese servicio sufrió una filtración de datos.</li>
    </ul>
  </aside>

  <!-- Cómo funciona (footer interno de la herramienta) -->
  <div class="mt-5 text-xs text-slate-500 leading-relaxed text-center">
    <strong class="text-slate-400 font-semibold">Cómo funciona:</strong> tus
    letras base se transforman con una cascada criptográfica (SHA-256 →
    HKDF → HMAC) ligada a tu clave personal y al servicio, así que el
    segmento reconocible sólo lo puedes reconstruir tú. Admiten el alfabeto
    español completo (ñ y vocales con tilde) — si los tipeas entran al
    segmento determinista; si no, se añaden al relleno aleatorio. Esto
    agranda el espacio de búsqueda contra atacantes que sólo manejan ASCII.
    El resto se completa con aleatoriedad criptográfica real y se reparte
    a ambos lados del segmento en cada clic, así que
    <u>cada clic en "Generar" produce una contraseña totalmente distinta</u>
    — el segmento se mueve, el relleno cambia, y la contraseña completa
    deja de ser reproducible. Guarda la que decidas usar (en un gestor de
    contraseñas, idealmente) antes de cerrar esta página.<br /><br />
    Para cuentas de alto valor (correo principal, banco, gestor de
    contraseñas) sigue siendo mejor usar un gestor de contraseñas con
    generación aleatoria real y verificación en dos pasos. Esta herramienta
    busca un equilibrio entre seguridad y memorabilidad para el resto de tus
    cuentas.
  </div>
</div>

<script>
  /**
   * Lógica del generador. Corre en el navegador; nada viaja a la red.
   * La inicialización se monta en `astro:page-load` y se desmonta en
   * `astro:before-swap` para no duplicar listeners al navegar con
   * view transitions. El guard se apoya en `data-password-gen` para
   * aislar el scope.
   */

  const LEET_MAP: Record<string, string> = {
    a: "@", e: "3", i: "1", o: "0", s: "$", t: "7", g: "9", b: "8", l: "|",
  };

  const CHARSET_BASE = "abcdefghijkmnopqrstuvwxyz"; // sin 'l' para evitar confusión visual
  const CHARSET_UPPER = "ABCDEFGHJKLMNPQRSTUVWXYZ";
  const CHARSET_DIGITS = "23456789";
  const CHARSET_SYMBOLS = "!@#%*-_+=?";
  // Letras del alfabeto español que NO están en ASCII: ñ/Ñ y las cinco
  // vocales con tilde. Activadas por el toggle "Español" (default ON).
  // No las mezclamos con CHARSET_UPPER ni con CHARSET_BASE para que el
  // opt-in sea explícito y se pueda apagar si el sitio destino es
  // ASCII puro.
  const CHARSET_ES = "ñÑáéíóúÁÉÍÓÚ";

  type Opts = { upper: boolean; digits: boolean; symbols: boolean; spanish: boolean };

  type BuildResult =
    | { error: string }
    | {
        password: string;
        transformed: string;
        hint: string;
        service: string;
        length: number;
        repeatWarning: boolean;
        hasInternalRepeat: boolean;
      };

  async function transformBase(
    letters: string,
    opts: Opts,
    secret: string,
    service: string,
  ): Promise<string> {
    // Si el toggle "Español" está apagado, strippeamos las letras
    // acentuadas y la ñ del input — si no, se filtran al prefijo
    // aunque el usuario las desactivó explícitamente.
    const clean = letters.replace(
      opts.spanish ? /[^a-zA-ZñÑáéíóúÁÉÍÓÚ]/g : /[^a-zA-Z]/g,
      "",
    );
    if (!clean) return "";

    // Tres algoritmos criptográficos en cascada, todos vía Web Crypto:
    //   1) SHA-256 sobre el material inicial derivado de
    //      (clave personal + servicio + dominio "pg-ikm-v1"). Cualquier
    //      cambio en el input cambia completamente el hash.
    //   2) HKDF-SHA256 (Extract + Expand) sobre ese hash, con info
    //      "pg-prefix-v1" para separar este uso del tag y de futuras claves.
    //   3) HMAC-SHA256 con la subclave: actúa como PRF por posición y
    //      escoge deterministamente un candidato del pool. Sin la subclave
    //      nadie puede predecir la elección, aunque conozca las letras
    //      base y el leetspeak típico (o → 0, s → $, etc.).
    const ikmBytes = new TextEncoder().encode(
      `${secret}|${service.toLowerCase()}|pg-ikm-v1`,
    );
    const ikmHash = new Uint8Array(await crypto.subtle.digest("SHA-256", ikmBytes));
    const hkdfKey = await crypto.subtle.importKey(
      "raw",
      ikmHash,
      "HKDF",
      false,
      ["deriveBits"],
    );
    const prefixKeyMat = new Uint8Array(
      await crypto.subtle.deriveBits(
        {
          name: "HKDF",
          hash: "SHA-256",
          salt: ikmHash,
          info: new TextEncoder().encode("pg-prefix-v1"),
        },
        hkdfKey,
        256,
      ),
    );
    const prefixKey = await crypto.subtle.importKey(
      "raw",
      prefixKeyMat,
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"],
    );

    let out = "";
    for (let i = 0; i < clean.length; i++) {
      const ch = clean[i];
      const lower = ch.toLowerCase();
      const leet = LEET_MAP[lower];

      // Pool de candidatos por carácter, respetando los toggles
      // activos. Mantenemos anclaje visual con la letra original
      // para que la contraseña siga siendo reconocible como tuya.
      const candidates: string[] = [lower];
      if (opts.upper) candidates.push(ch.toUpperCase());
      if (leet && leet >= "0" && leet <= "9" && opts.digits) {
        candidates.push(leet);
      }
      if (leet && (leet < "0" || leet > "9") && opts.symbols) {
        candidates.push(leet);
      }

      // Avalanche: el input HMAC incluye la base completa, así un
      // cambio en cualquier letra cambia la salida de TODAS las
      // posiciones.
      const sig = new Uint8Array(
        await crypto.subtle.sign(
          "HMAC",
          prefixKey,
          new TextEncoder().encode(`${i}|${clean}`),
        ),
      );
      out += candidates[sig[0] % candidates.length];
    }
    return out;
  }

  function charsetFor(opts: Opts): string {
    let set = CHARSET_BASE;
    if (opts.upper) set += CHARSET_UPPER;
    if (opts.digits) set += CHARSET_DIGITS;
    if (opts.symbols) set += CHARSET_SYMBOLS;
    if (opts.spanish) set += CHARSET_ES;
    return set;
  }

  /** Entero aleatorio uniforme en [0, maxExclusive) por rechazo (sin sesgo de módulo). */
  function randomInt(maxExclusive: number): number {
    const range = 256 - (256 % maxExclusive);
    const buf = new Uint8Array(1);
    let x: number;
    do {
      crypto.getRandomValues(buf);
      x = buf[0];
    } while (x >= range);
    return x % maxExclusive;
  }

  function uniqueRandomFromPool(poolArr: string[], count: number): string {
    const arr = poolArr.slice();
    const out: string[] = [];
    for (let i = 0; i < count && arr.length > 0; i++) {
      const idx = randomInt(arr.length);
      out.push(arr[idx]);
      arr.splice(idx, 1);
    }
    return out.join("");
  }

  /** Relleno con repetición permitida — solo cuando el conjunto es demasiado pequeño. */
  function fillerRandom(count: number, charset: string): string {
    const bytes = new Uint8Array(count);
    crypto.getRandomValues(bytes);
    let out = "";
    for (let i = 0; i < count; i++) {
      out += charset[bytes[i] % charset.length];
    }
    return out;
  }

  function ensureComplexity(pw: string, opts: Opts): string {
    const chars = pw.split("");
    const usedSet = new Set(chars);
    const pools: string[][] = [];
    if (opts.upper && !/[A-Z]/.test(pw)) pools.push(CHARSET_UPPER.split(""));
    if (opts.digits && !/[0-9]/.test(pw)) pools.push(CHARSET_DIGITS.split(""));
    if (opts.symbols && !/[!@#%*\-_+=?]/.test(pw)) pools.push(CHARSET_SYMBOLS.split(""));
    if (opts.spanish && !/[ñÑáéíóúÁÉÍÓÚ]/.test(pw)) pools.push(CHARSET_ES.split(""));

    pools.forEach((pool, i) => {
      const candidates = pool.filter((c) => !usedSet.has(c));
      const replaceIdx = chars.length - 1 - i;
      if (candidates.length === 0 || replaceIdx < 0) return; // sin candidato único: se deja así
      usedSet.delete(chars[replaceIdx]);
      const pick = candidates[randomInt(candidates.length)];
      chars[replaceIdx] = pick;
      usedSet.add(pick);
    });
    return chars.join("");
  }

  async function sha256Hex(message: string): Promise<string> {
    const enc = new TextEncoder().encode(message);
    const buf = await crypto.subtle.digest("SHA-256", enc);
    return Array.from(new Uint8Array(buf))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  function readOpts(): Opts {
    const get = (opt: string) =>
      document
        .querySelector<HTMLElement>(`[data-password-gen] .toggle[data-opt="${opt}"]`)
        ?.classList.contains("on") ?? false;
    return {
      upper: get("upper"),
      digits: get("digits"),
      symbols: get("symbols"),
      spanish: get("spanish"),
    };
  }

  async function buildPassword(): Promise<BuildResult> {
    const root = '[data-password-gen]';
    const baseRaw = (document.querySelector<HTMLInputElement>(`${root} #baseLetters`))?.value.trim();
    const secret = (document.querySelector<HTMLInputElement>(`${root} #secret`))?.value;
    const select = (document.querySelector<HTMLSelectElement>(`${root} #serviceSelect`))?.value;
    const custom = (document.querySelector<HTMLInputElement>(`${root} #serviceCustom`))?.value.trim();
    const service = !select || select === "__custom" ? custom : select;
    const lengthRaw = (document.querySelector<HTMLInputElement>(`${root} #lengthRange`))?.value;
    const length = parseInt(lengthRaw ?? "22", 10);

    if (!baseRaw || !secret || !service) {
      return { error: "Falta letras base, clave personal o servicio." };
    }

    const opts = readOpts();
    const transformed = await transformBase(baseRaw, opts, secret, service);
    const hintRaw = service.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 3);
    const hint = opts.digits ? hintRaw : hintRaw.replace(/[0-9]/g, "");
    const charset = charsetFor(opts);

    // El prefijo se derivó arriba con SHA-256 → HKDF → HMAC sobre
    // (clave + servicio), así que la clave personal también entra en el
    // patrón visible. Sin la clave nadie puede reconstruir el prefijo,
    // aunque conozca tus letras base y el leetspeak típico.
    const hash = await sha256Hex(
      secret + "|" + service.toLowerCase() + "|" + baseRaw.toLowerCase(),
    );
    const tagByte = parseInt(hash.substring(0, 2), 16) || 0;
    const tag = charset[tagByte % charset.length];

    // El guion bajo es un símbolo: sólo aparece si Símbolos está activo,
    // si no, el núcleo se queda con base + indicio + etiqueta.
    const separator = opts.symbols ? "_" : "";
    const core = transformed + separator + hint + tag;
    const remaining = Math.max(length - core.length, 4);

    // Relleno sin caracteres repetidos: ni entre sí, ni respecto al segmento
    // reconocible (core). Real aleatoriedad, distinta en cada clic.
    const usedSet = new Set(core.split(""));
    const poolArr = charset.split("").filter((c) => !usedSet.has(c));

    let filler: string;
    let repeatWarning = false;
    if (poolArr.length >= remaining) {
      filler = uniqueRandomFromPool(poolArr, remaining);
    } else {
      // El conjunto elegido es demasiado pequeño: se usa todo lo único posible
      // y se completa el resto permitiendo repetidos, avisando al usuario.
      filler = uniqueRandomFromPool(poolArr, poolArr.length);
      filler += fillerRandom(remaining - poolArr.length, charset);
      repeatWarning = true;
    }

    // Posición del segmento determinista dentro de la contraseña: varía
    // en cada clic (crypto.getRandomValues, no pseudo) para que no se
    // quede siempre al inicio. Si el núcleo ya llena la longitud (sin
    // hueco para relleno), la única posición posible es 0.
    const rootPos = remaining > 0 ? randomInt(remaining + 1) : 0;
    let combined =
      filler.slice(0, rootPos) + core + filler.slice(rootPos);
    if (combined.length > length) combined = combined.slice(0, length);
    if (combined.length < length) {
      combined += fillerRandom(length - combined.length, charset);
      repeatWarning = true;
    }
    combined = ensureComplexity(combined, opts);

    return {
      password: combined,
      transformed,
      hint,
      service,
      length: combined.length,
      repeatWarning,
      hasInternalRepeat: new Set(transformed.split("")).size < transformed.length,
    };
  }

  function strengthScore(pw: string): number {
    let score = 0;
    if (pw.length >= 16) score++;
    if (pw.length >= 22) score++;
    if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[!@#%*\-_+=?]/.test(pw)) score++;
    if (/[ñÑáéíóúÁÉÍÓÚ]/.test(pw)) score++;
    return score;
  }

  const STRENGTH_LABELS = [
    "muy débil",
    "débil",
    "aceptable",
    "buena",
    "fuerte",
    "muy fuerte",
  ];

  function renderReel(pw: string): void {
    const reel = document.querySelector<HTMLElement>("[data-password-gen] #reel");
    if (!reel) return;
    reel.innerHTML = "";
    pw.split("").forEach((ch, i) => {
      const span = document.createElement("span");
      span.className = "ch";
      span.style.animationDelay = i * 18 + "ms";
      span.textContent = ch;
      reel.appendChild(span);
    });
  }

  function renderStrength(pw: string): void {
    const wrap = document.querySelector<HTMLElement>("[data-password-gen] #strength");
    if (!wrap) return;
    wrap.classList.remove("hidden");
    wrap.classList.add("flex");
    const score = strengthScore(pw);
    wrap.querySelectorAll<HTMLElement>(".bar").forEach((b, i) =>
      b.classList.toggle("fill", i < score),
    );
    const labelEl = document.getElementById("strengthLabel");
    if (labelEl) labelEl.textContent = STRENGTH_LABELS[score] || STRENGTH_LABELS[0];
  }

  function renderBreakdown(result: Extract<BuildResult, { password: string }>): void {
    const el = document.getElementById("breakdown");
    if (!el) return;
    el.classList.remove("hidden");
    const lines: string[] = [
      `<b>base:</b> "${result.transformed}" transformada de tus letras`,
      `<b>indicio:</b> "${result.hint}" para el servicio (${result.service})`,
      `<b>relleno:</b> aleatorio real, sin repetir caracteres, distinto cada vez que generas`,
      `<b>longitud:</b> ${result.length} caracteres`,
    ];
    if (result.hasInternalRepeat) {
      lines.push(
        `<span class="warn">⚠ tus letras base tienen letras repetidas, así que ese segmento puede repetir un carácter — el resto de la contraseña no repite ninguno.</span>`,
      );
    }
    if (result.repeatWarning) {
      lines.push(
        `<span class="warn">⚠ con la longitud y los tipos de carácter elegidos no alcanzan caracteres únicos para todo el largo; se repitió alguno al final. Prueba activar más tipos de carácter (mayúsculas, números, símbolos) o reducir el largo.</span>`,
      );
    }
    el.innerHTML = lines.join("<br>");
  }

  type Scope = HTMLElement & { _pgInit?: boolean };

  function init(): void {
    const root = document.querySelector<Scope>("[data-password-gen]");
    if (!root || root._pgInit) return;
    root._pgInit = true;

    let lastPassword = "";

    const generateBtn = document.getElementById("generateBtn");
    const copyBtn = document.getElementById("copyBtn");
    const revealAgainBtn = document.getElementById("revealAgainBtn");
    const lengthRange = document.getElementById("lengthRange") as HTMLInputElement | null;
    const lengthVal = document.getElementById("lengthVal");
    const serviceSelect = document.getElementById("serviceSelect") as HTMLSelectElement | null;
    const serviceCustom = document.getElementById("serviceCustom") as HTMLInputElement | null;

    generateBtn?.addEventListener("click", async () => {
      if (!generateBtn) return;
      const original = generateBtn.textContent;
      generateBtn.textContent = "Calculando...";
      const result = await buildPassword();
      generateBtn.textContent = original ?? "Generar contraseña";

      if ("error" in result) {
        const reel = document.getElementById("reel");
        if (reel) {
          reel.innerHTML = `<span class="empty-hint">${result.error}</span>`;
        }
        const strength = document.getElementById("strength");
        const breakdown = document.getElementById("breakdown");
        if (strength) {
          strength.classList.add("hidden");
          strength.classList.remove("flex");
        }
        if (breakdown) breakdown.classList.add("hidden");
        return;
      }

      lastPassword = result.password;
      renderReel(result.password);
      renderStrength(result.password);
      renderBreakdown(result);
      copyBtn?.classList.remove("copied");
      if (copyBtn) copyBtn.textContent = "Copiar";
    });

    revealAgainBtn?.addEventListener("click", () => {
      if (lastPassword) renderReel(lastPassword);
    });

    copyBtn?.addEventListener("click", async () => {
      if (!lastPassword || !copyBtn) return;
      const original = copyBtn.textContent;
      try {
        await navigator.clipboard.writeText(lastPassword);
        copyBtn.textContent = "Copiado ✓";
        copyBtn.classList.add("copied");
        window.setTimeout(() => {
          copyBtn.textContent = original ?? "Copiar";
          copyBtn.classList.remove("copied");
        }, 1800);
      } catch {
        alert("No se pudo copiar automáticamente. Selecciónala manualmente: " + lastPassword);
      }
    });

    document.querySelectorAll<HTMLElement>("[data-password-gen] .toggle").forEach((t) => {
      t.addEventListener("click", () => {
        t.classList.toggle("on");
        document.dispatchEvent(
          new CustomEvent("pg:opts-changed", { detail: { opt: t.dataset.opt } }),
        );
      });
    });

    // Mensaje vivo sobre el input de letras base: aparece cuando el
    // toggle "Español" se apaga y avisa que la ñ y las vocales con
    // tilde se eliminarán del prefijo. También pinta el input con
    // borde amarillo como señal visual de "modo restringido".
    const syncBaseLettersHint = (): void => {
      const hint = document.getElementById("baseLettersHint");
      const input = document.getElementById("baseLetters");
      if (!hint || !input) return;

      const spanishOn = document
        .querySelector<HTMLElement>(
          '[data-password-gen] .toggle[data-opt="spanish"]',
        )
        ?.classList.contains("on") ?? true;

      if (spanishOn) {
        hint.textContent = "";
        hint.classList.add("hidden");
        input.classList.remove("pg-constrained");
        input.removeAttribute("aria-invalid");
      } else {
        hint.textContent =
          "Español desactivado — la ñ y las vocales con tilde (á, é, í, ó, ú) se eliminarán al generar.";
        hint.classList.remove("hidden");
        input.classList.add("pg-constrained");
        input.setAttribute("aria-invalid", "true");
      }
    };
    document.addEventListener("pg:opts-changed", syncBaseLettersHint);
    syncBaseLettersHint();

    if (lengthRange && lengthVal) {
      lengthRange.addEventListener("input", () => {
        lengthVal.textContent = lengthRange.value;
      });
    }

    if (serviceSelect && serviceCustom) {
      serviceSelect.addEventListener("change", (e) => {
        const v = (e.target as HTMLSelectElement).value;
        if (v && v !== "__custom") {
          serviceCustom.value = "";
          serviceCustom.placeholder = `usando "${v}"`;
        } else {
          serviceCustom.placeholder = "ej. spotify";
        }
      });
    }
  }

  function teardown(): void {
    const root = document.querySelector<Scope>("[data-password-gen]");
    if (root) delete root._pgInit;
  }

  init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", teardown);
</script>

