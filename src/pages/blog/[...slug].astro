---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import AdBanner from "../../components/AdBanner.astro";
import CommentSection from "../../components/CommentSection.astro";
import ShareActions from "../../components/ShareActions.astro";
import { Image } from "astro:assets";
import ogImage from "../../assets/og-image.jpg";

export const prerender = false;

const { slug } = Astro.params;
const allPosts = await getCollection("blog");
const post = allPosts.find(
  (p) => p.slug === slug && (!p.data.draft || import.meta.env.DEV),
);
if (!post) return Astro.redirect("/404");
const { Content, headings } = await post.render();
const currentUrl = Astro.url.href;

// Usar imagen del post si existe, si no, usar la del sitio
const socialImage =
  post.data.socialImage?.src || post.data.image?.src || ogImage.src;
---

<Layout
  title={`${post.data.title} | Blog Juan Oliver`}
  description={post.data.description}
  image={socialImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  author={post.data.author || "Juan Oliver"}
>
  <article class="container mx-auto px-4 py-12">
    <header
      class="max-w-4xl mx-auto mb-12 text-center border-b border-slate-200 dark:border-slate-700 pb-8"
    >
      <div
        class="flex items-center justify-center gap-4 text-sm text-slate-500 dark:text-slate-400 mb-6"
      >
        <time datetime={post.data.date.toISOString()}>
          {
            post.data.date.toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <div class="flex gap-2">
          {
            post.data.categories.map((cat) => (
              <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 uppercase tracking-wide">
                {cat}
              </span>
            ))
          }
        </div>
      </div>
      <h1
        class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight"
      >
        {post.data.title}
      </h1>
      <p
        class="text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-8"
      >
        {post.data.description}
      </p>

      {
        (post.data.socialImage ?? post.data.image) && (
          <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl animate-fade-in-up">
            <Image
              id="hero-image"
              src={post.data.socialImage ?? post.data.image!}
              alt={post.data.title}
              class="w-full h-auto object-cover max-h-[500px]"
              loading="eager"
              transition:name={`hero-${post.slug}`}
            />
          </div>
        )
      }
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-8">
        <div class="lg:hidden mb-8">
          {
            post.data.showToc && headings.length > 0 && (
              <TableOfContents
                headings={headings}
                title="Tabla de Contenido"
                showProgress={true}
                sticky={true}
              />
            )
          }
        </div>

        <div
          class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-img:rounded-xl prose-img:shadow-lg prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-code:text-slate-100 prose-p:leading-loose prose-li:leading-loose"
        >
          <Content />
        </div>

        <CommentSection slug={post.slug} />

        <ShareActions
          url={currentUrl}
          title={post.data.title}
          description={post.data.description}
        />
      </div>

      <aside class="hidden md:block md:col-span-4">
        <div class="sticky top-24">
          {
            post.data.showToc && headings.length > 0 && (
              <TableOfContents
                headings={headings}
                title="Tabla de Contenido"
                showProgress={true}
                sticky={false}
              />
            )
          }

          <!-- AdSense Sidebar -->
          <div class="mt-8 sticky top-[calc(6rem+200px)]">
            <AdBanner
              label="Anuncio Sidebar Artículo"
              slotId="6192766305"
              format="vertical"
              localAd={true}
            />
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<script>
  // Inline SVG for proper dark mode support
  const inlineSvg = () => {
    const img = document.getElementById("hero-image") as HTMLImageElement;
    // Check if image exists and is an SVG (loose check for .svg extension)
    if (img && img.src && img.src.includes(".svg")) {
      fetch(img.src)
        .then((response) => response.text())
        .then((svgText) => {
          const div = document.createElement("div");
          div.innerHTML = svgText;
          const svg = div.querySelector("svg");
          if (svg) {
            // Copy classes
            const currentClass = img.getAttribute("class") || "";
            svg.setAttribute("class", currentClass);

            // Copy styles
            const currentStyle = img.getAttribute("style") || "";
            svg.setAttribute("style", currentStyle);

            // Preserve accessible name if present
            const alt = img.getAttribute("alt");
            if (alt && !svg.hasAttribute("aria-label")) {
              svg.setAttribute("aria-label", alt);
            }
            if (!svg.hasAttribute("role")) {
              svg.setAttribute("role", "img");
            }

            // Auto-detect if SVG needs color inversion for dark mode
            // If it uses CSS variables, it likely handles dark mode itself.
            // If not, apply a filter helper class.
            if (!svgText.includes("var(--")) {
              svg.classList.add("svg-auto-dark");
            }

            // Replace image with SVG
            img.replaceWith(svg);
          }
        })
        .catch((err) => console.error("Error inlining SVG:", err));
    }
  };

  // Run on initial load and View Transition navigations
  document.addEventListener("astro:page-load", inlineSvg);
</script>
